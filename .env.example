# These are retrieved from your project at app.tina.io
NEXT_PUBLIC_TINA_CLIENT_ID=***
TINA_TOKEN=***

# This is set by default CI with Netlify/Vercel/Github, but can be overriden
NEXT_PUBLIC_TINA_BRANCH=***

# Amazon Creators API credentials, from Associates Central > Tools > Creators API.
# Without them the build falls back to the link and image URLs already in the content.
AMAZON_CREATORS_CREDENTIAL_ID=***
AMAZON_CREATORS_CREDENTIAL_SECRET=***